# Copia questo file come .env (nella stessa cartella) e incolla le tue chiavi.
# Il file .env non viene mai caricato su GitHub.
YT_API_KEY=incolla-qui-la-chiave

# Per PUBBLICARE (client OAuth di tipo "App desktop" in Google Cloud Console):
YT_CLIENT_ID=incolla-qui-id-client.apps.googleusercontent.com
YT_CLIENT_SECRET=incolla-qui-il-secret
# Questo lo scrive da solo:  python autorizza_youtube.py
YT_REFRESH_TOKEN=
